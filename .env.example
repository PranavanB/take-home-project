LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=job-matcher-llm
EMBEDDING_BASE_URL=http://embedding:80/v1
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0
SKILL_VECTOR_MINIMUM_SIMILARITY=0.25
SKILL_VECTOR_MINIMUM_MARGIN=0.04
SESSION_ROOT=/tmp/job-matcher-sessions
SESSION_TTL_SECONDS=600
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=25
MAX_DOCX_UNCOMPRESSED_BYTES=52428800
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=30
JOB_DATASET_ROOT=/app/seed/jobs
SKILL_CATALOG_PATH=/app/seed/skills/skills.json
INDUSTRY_CATALOG_PATH=/app/seed/industries/naics-2022.json
