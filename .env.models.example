# Copy this file to .env.models. No Hugging Face token is needed for the public default model.
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=job-matcher-llm

# Arctic Embed 2.0 runs in a separate CPU container so the main LLM keeps the GPU.
EMBEDDING_BASE_URL=http://embedding:80/v1
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0
SKILL_VECTOR_MINIMUM_SIMILARITY=0.25
SKILL_VECTOR_MINIMUM_MARGIN=0.04

# vLLM runs in its own container and keeps model/compile caches in named Docker volumes.
VLLM_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4-Fast
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_NUM_SEQS=2
HF_TOKEN=

# LLM extraction and Arctic vector mapping feed exact in-memory database joins.
